#!/bin/sh
# iAgent prerm — 删除二进制前先停掉守护进程。
# 用户数据 /var/mobile/Library/iAgent 刻意保留。
#
# 和 postinst 一样：绝不在 dpkg 事务里 respring（会把 Sileo 和 dpkg 一起杀掉，
# 留下 "dpkg 已中断"），也绝不非零退出。

PKG="com.dsh.iagent"
DATA_DIR="/var/mobile/Library/iAgent"
LOG_DIR="$DATA_DIR/logs"

log() {
	echo "[iAgent] $*"
	mkdir -p "$LOG_DIR" 2>/dev/null
	echo "$(date '+%Y-%m-%d %H:%M:%S') [prerm] $*" >>"$LOG_DIR/postinst.log" 2>/dev/null
}

SELF="$0"
case "$SELF" in
	*/*) ;;
	*) if command -v "$SELF" >/dev/null 2>&1; then SELF="$(command -v "$SELF")"; fi ;;
esac
JBROOT="${SELF%%/var/lib/dpkg/info/*}"
if [ "$JBROOT" = "$SELF" ] || [ -z "$JBROOT" ]; then
	if [ -d /var/jb ]; then
		JBROOT="/var/jb"
	else
		JBROOT=""
	fi
fi

PLIST="$JBROOT/Library/LaunchDaemons/$PKG.daemon.plist"
if [ -x "$JBROOT/usr/bin/launchctl" ]; then
	LAUNCHCTL="$JBROOT/usr/bin/launchctl"
else
	LAUNCHCTL="launchctl"
fi

"$LAUNCHCTL" bootout system "$PLIST" >/dev/null 2>&1 ||
	"$LAUNCHCTL" unload -w "$PLIST" >/dev/null 2>&1

rm -f "$JBROOT/basebin/LaunchDaemons/$PKG.daemon.plist" 2>/dev/null
killall iagentd >/dev/null 2>&1

log "已停止守护进程并清理 LaunchDaemon；用户数据保留在 $DATA_DIR"
log "SpringBoard 里仍映射着旧的 dylib，想彻底清掉需要重启一次 SpringBoard（本脚本不会替你重启）。"
exit 0
