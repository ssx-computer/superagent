<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    LaunchDaemon for iagentd.

    The path below is the rootless/Dopamine one (/var/jb/usr/bin/iagentd).
    DEBIAN/postinst rewrites every "/var/jb" occurrence to the real jailbreak
    root when it is different (RootHide uses a randomised jbroot and has no
    /var/jb at all), so this file is correct on both after installation.

    IMPORTANT: Theos prefixes layout/ with the scheme's install prefix, so the
    file ends up at <jbroot>/Library/LaunchDaemons/com.dsh.iagent.daemon.plist.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dsh.iagent.daemon</string>

    <key>ProgramArguments</key>
    <array>
        <string>/var/jb/usr/bin/iagentd</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <!--
        KeepAlive = true（无条件常驻）。这里以前是
        <dict><key>SuccessfulExit</key><false/></dict>，语义是"只在退出码非 0 时重启"：
        进程被信号打死（SIGSEGV/SIGBUS/SIGKILL）或被系统强制退出时，launchd 认为
        "已经退出过、结果不是成功"，于是**不会把它拉起来**——用户看到的就是控制面板
        再也连不上。改成 true 之后无论怎么退出都会被重新启动；配合下面的
        ThrottleInterval=5 防止崩溃循环打满 CPU。
        这个文件打包时会被 Theos 转成 binary plist，postinst 会用
        usr/share/iagent/iagent.daemon.plist.template 重新生成一份文本版，
        所以两处的 KeepAlive 必须一致。
    -->
    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>5</integer>

    <!-- launchd creates these files; the directory is created by postinst. -->
    <key>StandardOutPath</key>
    <string>/var/mobile/Library/iAgent/logs/iagentd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/var/mobile/Library/iAgent/logs/iagentd.err.log</string>

    <key>WorkingDirectory</key>
    <string>/var/mobile</string>

    <key>ProcessType</key>
    <string>Interactive</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/var/jb/usr/bin:/var/jb/bin:/var/jb/sbin:/var/jb/usr/sbin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>TERM</key>
        <string>xterm-256color</string>
        <key>LANG</key>
        <string>zh_CN.UTF-8</string>
        <key>HOME</key>
        <string>/var/mobile</string>
    </dict>
</dict>
</plist>
