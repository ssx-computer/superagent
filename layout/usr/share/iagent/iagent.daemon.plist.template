<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    LaunchDaemon 模板（纯 XML 文本）。

    为什么要有这个文件：Theos 打包时会把 layout/ 里的 plist 转成 **binary plist**
    （bplist00），而二进制 plist 内部有偏移表，用 sed 改字符串会破坏它，launchd 就
    读不了。所以 postinst 用它重新生成一份纯 XML 的 plist 覆盖进去：
    @JBROOT@ 会被替换成真实的越狱根目录（Dopamine = /var/jb，RootHide = 随机
    .jbroot-<hex>，rootful = 空字符串 → 得到 /usr/bin/iagentd）。

    日志与工作目录固定在 rootfs 的 /var/mobile 下（RootHide 的 jbroot 会随越狱更新
    变化，用户数据不该跟着消失）。
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dsh.iagent.daemon</string>

    <key>ProgramArguments</key>
    <array>
        <string>@JBROOT@/usr/bin/iagentd</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <!--
        KeepAlive = true（无条件常驻）。原先的
        <dict><key>SuccessfulExit</key><false/></dict> 只在"退出码非 0"时重启，
        被信号杀死或被系统强制退出的守护进程不会被拉起来，控制面板就永远连不上了。
        ThrottleInterval=5 防止崩溃循环打满 CPU。这个模板与
        layout/Library/LaunchDaemons/com.dsh.iagent.daemon.plist 必须保持一致
        （打包时后者会被转成 binary plist，postinst 用本模板覆盖它）。
    -->
    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>5</integer>

    <key>StandardOutPath</key>
    <string>/var/mobile/Library/iAgent/logs/iagentd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/var/mobile/Library/iAgent/logs/iagentd.err.log</string>

    <key>WorkingDirectory</key>
    <string>/var/mobile</string>

    <key>ProcessType</key>
    <string>Interactive</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>@JBROOT@/usr/bin:@JBROOT@/bin:@JBROOT@/sbin:@JBROOT@/usr/sbin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>TERM</key>
        <string>xterm-256color</string>
        <key>LANG</key>
        <string>zh_CN.UTF-8</string>
        <key>HOME</key>
        <string>/var/mobile</string>
    </dict>
</dict>
</plist>
